# ============================================================
# ERP UNIVERSAL MODULAR — Plantilla de variables de entorno
# ------------------------------------------------------------
# INSTRUCCIONES PARA EL ADMINISTRADOR:
#   1. Copia este archivo y renómbralo como .env (raíz del proyecto).
#   2. Completa cada valor con información REAL tuya.
#   3. .env está en .gitignore: NUNCA se sube a Git.
#
# Este archivo NO contiene credenciales reales. Los valores se
# dejan vacíos a propósito. El backend validará estas variables
# al arrancar y fallará con un mensaje claro si faltan.
# ============================================================

# --- Base de datos ---
# URL de conexión de MongoDB Atlas
# (panel de Atlas -> Connect -> Drivers -> Copy)
MONGODB_URI=
MONGODB_DB_NAME=erp_universal
# Opcional: DNS alternativo solo para el proceso del ERP, si falla querySrv.
# Deja vacío para usar el DNS del entorno, especialmente en Render.
MONGODB_DNS_SERVERS=
# --- Seguridad ---
# Secreto para firmar los tokens JWT. Genera uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Nunca reutilices un secreto entre entornos (development/test/production).
JWT_SECRET=

# --- Servidor ---
# Puerto HTTP del backend (ejemplo de formato: 4000)
PORT=

# Entorno de ejecución: development | test | production
NODE_ENV=
# Perfil de datos, independiente de NODE_ENV: development | test | demo | production
# La instalación ficticia actual usa demo. Producción exige erp_production.
ERP_ENVIRONMENT=demo

# --- Frontend ---
# URL pública del API versionada (ejemplo de formato: http://localhost:4000/api/v1)
API_URL=
CORS_ORIGIN=http://localhost:3000

# --- Chatbot: solo demo, desactivado por defecto ---
CHATBOT_PROVIDER=guided
# Introducir solo en el backend/Render. Nunca usar prefijo VITE_ ni subir la clave.
OPENAI_API_KEY=
# Modelo compatible con Responses y Structured Outputs.
OPENAI_MODEL=
# Máximo de intentos por día UTC entre todas las instancias.
CHATBOT_DAILY_LIMIT=25

# Alternativa Gemini para el modo híbrido (activar con CHATBOT_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CHATBOT_CONVERSATION_LIMIT=3
CHATBOT_VISITOR_DAILY_LIMIT=10
CHATBOT_MINUTE_LIMIT=3
