{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "admin:create": "tsx src/scripts/create-initial-admin.ts",
    "test": "vitest run",
    "test:stock:integration": "vitest run --config vitest.stock.config.ts",
    "test:stock:local": "node scripts/run-stock-integration.mjs",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:mongodb": "tsx src/scripts/check-mongodb.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "mongodb-memory-server-core": "^10.4.3",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  }
}
